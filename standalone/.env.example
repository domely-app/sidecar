# Copy to .env and fill in. .env is gitignored and holds a credential with full access to your
# home, so it never enters a commit, a screenshot or a log line.

# Base URL of your Home Assistant instance, as reachable from inside the container.
# Not localhost: inside a container that is the container, not your machine.
HA_URL=http://192.168.1.50:8123

# Long-lived access token. Home Assistant, click your avatar bottom left, Security tab,
# Long-lived access tokens, Create token. It is shown exactly once.
HA_TOKEN=

# Shared secret for the internal channel between the API layer and the adapter (ADR-0004). Both
# processes read this one variable and neither starts without it. Generate one with:
#   openssl rand -hex 32
ADAPTER_SECRET=

# Where the adapter pushes state changes, the internal channel's second direction (ADR-0008): the
# API service on the compose network, never a published port. Blank switches the push off and
# leaves the mirror being written as before, which means the event stream carries nothing.
# EVENT_PUSH_TIMEOUT_MS bounds one push, and a push that times out is logged and dropped rather
# than holding up the Home Assistant connection, so it can stay short.
API_URL=http://api:8080
EVENT_PUSH_TIMEOUT_MS=2000

# Base URL of Domely Cloud. Leave it empty and the Agent never pairs, mirrors state as it always
# has, and serves nothing publicly. Set it and the adapter asks for a pairing code at startup and
# prints it in the log for you to redeem in the browser.
CLOUD_URL=

# Seconds the pairing poll backs off to while the cloud is unreachable, and the per-request
# timeout on every call to it. The defaults suit a home broadband connection.
PAIRING_POLL_MAX_INTERVAL=60
CLOUD_TIMEOUT=10

# How the Agent keeps its authorization current: seconds between grant set pulls, the ceiling the
# sync backs off to while the cloud is unreachable, and how often the cloud's signing keys are
# refreshed. Nothing here expires: an Agent whose cloud has been down for a month authorizes
# exactly what it did at the last pull.
GRANT_SYNC_INTERVAL=300
GRANT_SYNC_MAX_INTERVAL=3600
JWKS_REFRESH_INTERVAL=3600

# Seconds after which the grant set is called stale, in the adapter's log and in GET /health.
# Read by both processes, so the two cannot disagree about it.
GRANTS_STALE_AFTER=900

# How deep the energy insights backfill walks on the first tick after this home opts in (ADR-0012),
# in days. Home Assistant keeps hourly statistics indefinitely, so the default is more history than
# most recorders hold and costs one empty read per chunk where they hold none. It is walked once:
# after that the loop sends yesterday, nightly.
INSIGHTS_BACKFILL_DAYS=730

# Where the adapter writes the credentials cloudflared reads, and the file domely:unpair deletes.
# Read by all three services for the same reason: it is one file, and telling them different names
# for it would leave an unpaired Agent with a raisable tunnel, or a paired one with none.
TUNNEL_CREDENTIALS_PATH=/var/lib/domely-tunnel/tunnel-credentials.json

# Seconds of clock skew the API allows on a token. A home runs on hardware with no battery-backed
# clock, so a minute of drift must not lock the house out.
JWT_LEEWAY=60

# debug | info | warn | error
LOG_LEVEL=info

# What the app calls this home, shown by GET /api/home.
HOME_NAME=Home

# FrankenPHP threads in the API container. One is held per open event-stream connection from
# M4 onwards, so size it for the number of phones in the house rather than the number of people.
API_THREADS=8

# Host port for the API, on loopback only. Change it if something else already has 8080.
API_PORT=8080

# Seconds the API waits at start for the adapter's internal channel to answer. Raise it if your
# Home Assistant is slow to come up, since the adapter only binds the channel once it is connected.
CHANNEL_CHECK_WAIT=10

# Seconds a pushed state change is kept in the API layer's events table, the buffer between the
# adapter's push and the open streams. Not a history: a client that was away refetches the whole
# state when it reconnects, so anything older than a moment is of no use to anyone.
EVENTS_RETENTION=60

# How many automations this home may hold. A safety net, refused at the write past it, and it
# bounds the count only: an Agent already over it still runs every automation it has.
AUTOMATION_CAP=50

# The event stream. The tick is both how long a change waits before a client sees it and how often
# each open stream queries SQLite, so it trades latency against reads. The heartbeat keeps the
# tunnel hop and mobile NAT from dropping an idle connection. The lifetime is a ceiling rather
# than a preference: one FrankenPHP thread is held per open stream, so this and API_THREADS are
# sized together.
EVENT_STREAM_POLL_MS=200
EVENT_STREAM_HEARTBEAT=15
EVENT_STREAM_MAX_SECONDS=300

# Comma-separated browser origins allowed to call this API, which means the address Domely Cloud
# serves the app from. Every call the app makes is cross-origin, so the browser drops every answer
# this list does not name. Left empty, no browser reaches this Agent at all: that is the safe
# default and it is also why the app does nothing until this is filled in. Never "*", because the
# tunnel hostname is public and the token lives in the app's storage.
CORS_ORIGINS=
